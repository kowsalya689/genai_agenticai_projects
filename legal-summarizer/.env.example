# Copy to .env and edit. Every setting is optional; the defaults work for local use.
ENVIRONMENT=development          # production hides /docs and turns on HSTS
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Folder produced by the notebook (section 14). If it does not exist the app downloads facebook/bart-large-cnn instead.
MODEL_DIR=model/bart_legal_final
DEVICE=auto                      # auto | cpu | cuda
PRELOAD_MODEL=true

# Pipeline (same values as the notebook)
TARGET_COMPRESSION=0.20
FINAL_CAP_TOKENS=350
CHUNK_TOKENS=900
NUM_BEAMS=4

# Limits and headers
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=5
MAX_CHARS=400000
RATE_LIMIT_PER_MINUTE=30         # per IP on /summarize and /extract, 0 = off
